# Evaluation-only process overlay; keep secrets in existing .env/environment.
# Apply before importing app dependencies. Does not change the normal service config.
RAGAS_ONLINE_ENABLED=false
API_RESPONSE_LOGGING_ENABLED=false
APP_DEBUG=false
# Shared US$2.50 budget, token caps and zero retries are wired by
# scripts.agent_evaluation_runtime.EvaluationResources, not by these flags alone.
