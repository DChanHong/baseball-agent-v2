APP_NAME="New Baseball API"
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=4000
APP_BASE_URL=http://127.0.0.1:4000
APP_DEBUG=true
API_RESPONSE_LOGGING_ENABLED=true
API_RESPONSE_LOG_DIR=logs/api-responses
API_RESPONSE_LOG_MAX_BODY_BYTES=1000000
CORS_ALLOW_ORIGINS=http://127.0.0.1:3001,http://localhost:3001,http://192.168.1.186:3001,http://127.0.0.1:3000,http://localhost:3000,http://192.168.1.186:3000

# Supabase local PostgreSQL connection
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Auth. For local QA, use `supabase status` values after `supabase start`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_APP_URL=http://127.0.0.1:3001
AUTH_COOKIE_SECURE=false
AUTH_ACCESS_COOKIE_NAME=nb_access_token
AUTH_REFRESH_COOKIE_NAME=nb_refresh_token
AUTH_OAUTH_STATE_COOKIE_NAME=nb_oauth_state
AUTH_OAUTH_VERIFIER_COOKIE_NAME=nb_oauth_code_verifier
AUTH_REFRESH_COOKIE_MAX_AGE_SECONDS=5184000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=30

# KMA short-term forecast API
KMA_API_ENDPOINT=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
KMA_SERVICE_KEY=
