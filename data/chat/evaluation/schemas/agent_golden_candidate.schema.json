          "type": "string"
        },
        "rank_metrics_ready": {
          "const": false,
          "title": "Rank Metrics Ready",
          "type": "boolean"
        },
        "baseline_ready": {
          "const": false,
          "title": "Baseline Ready",
          "type": "boolean"
        }
      },
      "required": [
        "run_status",
        "ragas_input_scope",
        "metric_policy",
        "rank_metrics_ready",
        "baseline_ready"
      ],
      "title": "Evaluation",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
