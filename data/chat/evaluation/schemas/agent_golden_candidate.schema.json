{
  "$defs": {
    "Case": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^golden_(guide|ticket|knowledge|mixed|scope)_\\d{3}$",
          "title": "Case Id",
          "type": "string"
        },
        "dataset_version": {
          "title": "Dataset Version",
          "type": "string"
        },
        "category": {
          "enum": [
            "stadium_guide",
            "ticketing",
            "baseball_knowledge",
            "mixed_follow_up",
            "insufficient_out_of_scope"
          ],
          "title": "Category",
          "type": "string"
        },
        "split": {
          "enum": [
            "development",
            "held_out"
          ],
          "title": "Split",
          "type": "string"
        },
        "related_case_ids": {
          "items": {
            "type": "string"
          },
          "title": "Related Case Ids",
          "type": "array"
        },
        "fact_groups": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Fact Groups",
          "type": "array"
        },
        "input": {
          "$ref": "#/$defs/CaseInput"
        },
        "expected": {
          "$ref": "#/$defs/Expected"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "retrieval_ground_truth": {
          "$ref": "#/$defs/Retrieval"
        },
        "review": {
          "$ref": "#/$defs/Review"
        },
        "evaluation": {
          "$ref": "#/$defs/Evaluation"
        },
        "final_review": {
          "$ref": "#/$defs/FinalReview"
        }
      },
      "required": [
        "case_id",
        "dataset_version",
        "category",
        "split",
        "related_case_ids",
        "fact_groups",
        "input",
        "expected",
        "evidence",
        "retrieval_ground_truth",
        "review",
        "evaluation",
        "final_review"
      ],
      "title": "Case",
      "type": "object"
    },
    "CaseInput": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "today": {
          "format": "date",
          "title": "Today",
          "type": "string"
        },
        "timezone": {
          "const": "Asia/Seoul",
          "title": "Timezone",
          "type": "string"
        },
        "auth_status": {
          "const": "authenticated",
          "title": "Auth Status",
          "type": "string"
        },
        "favorite_team_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Favorite Team Id"
        },
        "history": {
          "items": {
            "$ref": "#/$defs/Turn"
          },
          "title": "History",
          "type": "array"
        },
        "conversation_context": {
          "additionalProperties": true,
          "title": "Conversation Context",
          "type": "object"
        },
        "context_mode": {
          "enum": [
            "fixed_synthetic_fixture",
            "fresh_conversation"
          ],
          "title": "Context Mode",
          "type": "string"
        },
        "event_scope": {
          "title": "Event Scope",
          "type": "string"
        }
      },
      "required": [
        "question",
        "today",
        "timezone",
        "auth_status",
        "favorite_team_id",
        "history",
        "conversation_context",
        "context_mode",
        "event_scope"
      ],
      "title": "CaseInput",
      "type": "object"
    },
    "ChunkCandidate": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "logical_document_id": {
          "title": "Logical Document Id",
          "type": "null"
        },
        "revision_id": {
          "title": "Revision Id",
          "type": "null"
        },
        "relevance_grade": {
          "anyOf": [
            {
              "enum": [
                0,
                1,
                2
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Relevance Grade"
        },
        "label_status": {
          "enum": [
            "agent_reviewed_local",
            "source_review_pending"
          ],
          "title": "Label Status",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "evidence_spans": {
          "items": {
            "$ref": "#/$defs/ChunkSpan"
          },
          "title": "Evidence Spans",
          "type": "array"
        },
        "passes_expected_filter": {
          "title": "Passes Expected Filter",
          "type": "boolean"
        }
      },
      "required": [
        "document_id",
        "chunk_id",
        "content_sha256",
        "logical_document_id",
        "revision_id",
        "relevance_grade",
        "label_status",
        "reason",
        "evidence_spans",
        "passes_expected_filter"
      ],
      "title": "ChunkCandidate",
      "type": "object"
    },
    "ChunkSpan": {
      "additionalProperties": false,
      "properties": {
        "fact_index": {
          "minimum": 0,
          "title": "Fact Index",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "support": {
          "enum": [
            "full",
            "partial"
          ],
          "title": "Support",
          "type": "string"
        }
      },
      "required": [
        "fact_index",
        "start",
        "end",
        "text",
        "support"
      ],
      "title": "ChunkSpan",
      "type": "object"
    },
    "DbValidation": {
      "additionalProperties": false,
      "properties": {
        "environment": {
          "const": "local_supabase",
