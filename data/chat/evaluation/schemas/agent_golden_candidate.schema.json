          "type": "string"
        },
        "ragas_input_scope": {
          "title": "Ragas Input Scope",
          "type": "string"
        },
        "metric_policy": {
          "enum": [
            "conditional_rag",
            "agent_behavior_only",
            "pending_multi_tool_adapter"
