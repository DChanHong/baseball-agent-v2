        },
        "actual_matching_chunk_ids": {
          "items": {
            "type": "string"
          },
          "title": "Actual Matching Chunk Ids",
          "type": "array"
        },
        "missing_retrieval_fact_indexes": {
          "items": {
            "type": "integer"
          },
          "title": "Missing Retrieval Fact Indexes",
          "type": "array"
        },
        "unresolved_source_fact_indexes": {
          "items": {
            "type": "integer"
          },
          "title": "Unresolved Source Fact Indexes",
          "type": "array"
        },
        "note": {
          "title": "Note",
          "type": "string"
        }
